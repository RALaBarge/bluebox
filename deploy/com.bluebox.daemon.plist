<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.bluebox.daemon</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/env</string>
    <string>python3</string>
    <string>REPLACE_ME/repos/bluebox/voice_daemon.py</string>
  </array>

  <!-- launchd starts services with a minimal PATH. The pipeline shells out to
       ffmpeg (parakeet) and needs homebrew's bin visible, so set it here
       rather than relying on the daemon's own PATH repair. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>PYTHONUNBUFFERED</key>
    <string>1</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>

  <key>StandardOutPath</key>
  <string>/tmp/bluebox-daemon.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/bluebox-daemon.err</string>
</dict>
</plist>
